# VoyageX — example environment file
#
# Copy to .env and replace the dummy values. .env is git-ignored and must never
# be committed (SRS constraint C-07, NFR-12).
#
#   cp .env.example .env
#
# Every value below is a placeholder. None of these are real credentials.

# --- Database ---------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=travel_tourism
PGDATABASE_TEST=travel_test

# Superuser used ONLY by db/reset.sh to create roles and rebuild the schema.
# The application never connects with this account.
PGADMIN_USER=postgres
PGADMIN_PASSWORD=replace_me

# One connection per database role. These are the RBAC enforcement points:
# each pool connects as a role with exactly the privileges that role should have.
PG_CUSTOMER_USER=app_customer
PG_CUSTOMER_PASSWORD=replace_me
PG_AGENT_USER=app_agent
PG_AGENT_PASSWORD=replace_me
PG_MANAGER_USER=app_manager
PG_MANAGER_PASSWORD=replace_me
PG_DBADMIN_USER=app_dbadmin
PG_DBADMIN_PASSWORD=replace_me
PG_CONSOLE_RO_USER=sql_console_ro
PG_CONSOLE_RO_PASSWORD=replace_me

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
NODE_ENV=development

# Generate your own, e.g.  openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- Client -----------------------------------------------------------------
CLIENT_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:4000

# --- Prediction service -----------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=3000
ML_MODEL_VERSION=v1

# --- Limits -----------------------------------------------------------------
CONSOLE_RATE_LIMIT_PER_MIN=10
CONSOLE_STATEMENT_TIMEOUT=5s
ADMIN_STATEMENT_TIMEOUT=10s
ADMIN_LOCK_TIMEOUT=3s

# --- Seeding ----------------------------------------------------------------
# Fixed so that seeded data is reproducible and figures in the report match.
SEED_RANDOM_SEED=20260926
