# =============================================================================
# VoyageX — environment configuration
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# ONE file, at the repository root. It is read by:
#   * db/reset.sh      — to build the database and set the role passwords
#   * server/          — the API (via server/loadEnv.js)
#   * the test suite   — via vitest.config.js
#
# .env is git-ignored and must never be committed (SRS C-07, NFR-12).
# Every value below is a local development placeholder, not a real credential.
#
# WHAT YOU ACTUALLY HAVE TO CHANGE
#   1. PGADMIN_PASSWORD — the password you set for the `postgres` superuser
#      when you installed PostgreSQL. Nothing else will work until this is right.
#   2. JWT_SECRET — any long random string of your own.
#   The rest can stay as they are for local development.
# =============================================================================

# --- Database connection -----------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=travel_tourism
PGDATABASE_TEST=travel_test

# The PostgreSQL superuser. Used ONLY by db/reset.sh, to create the database,
# build the schema and create the five application roles. The API never
# connects with this account.
#
# >>> CHANGE THIS to the password you chose during the PostgreSQL install. <<<
PGADMIN_USER=postgres
PGADMIN_PASSWORD=postgres

# --- Application database roles ----------------------------------------------
# One connection pool per role is how access control is enforced (ADR-03).
# db/reset.sh sets these passwords on the roles it creates, so the values here
# and the values in the database always agree.
PG_CUSTOMER_USER=app_customer
PG_CUSTOMER_PASSWORD=voyagex_customer_dev
PG_AGENT_USER=app_agent
PG_AGENT_PASSWORD=voyagex_agent_dev
PG_MANAGER_USER=app_manager
PG_MANAGER_PASSWORD=voyagex_manager_dev
PG_DBADMIN_USER=app_dbadmin
PG_DBADMIN_PASSWORD=voyagex_dbadmin_dev
PG_CONSOLE_RO_USER=sql_console_ro
PG_CONSOLE_RO_PASSWORD=voyagex_console_dev

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
NODE_ENV=development

# >>> CHANGE THIS. Generate one with:  openssl rand -base64 48
# (On Windows PowerShell:
#   [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})) )
# The API refuses to start if this is left as the placeholder text below.
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- Client ------------------------------------------------------------------
# The Vite dev server proxies /api to the API, so the browser sees one origin
# and CORS never applies in development.
CLIENT_ORIGIN=http://127.0.0.1:5173

# --- Limits ------------------------------------------------------------------
PG_POOL_MAX=4
PG_STATEMENT_TIMEOUT_MS=15000
AUTH_RATE_LIMIT=30
API_RATE_LIMIT=300

# --- Seeding -----------------------------------------------------------------
# Fixed, so seeded data is identical on every machine and the figures quoted in
# the report reproduce exactly. Do not change it casually.
SEED_RANDOM_SEED=20260926
