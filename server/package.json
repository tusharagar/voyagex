{
  "name": "voyagex-api",
  "version": "0.6.0",
  "private": true,
  "description": "VoyageX API — Express over PostgreSQL, no ORM (ADR-01)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server.js",
