# --- Secrets: never commit. .env.example carries dummy values instead. ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*
dist/
.vite/
coverage/
tests/results.json

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# --- Database ---
pgdata/
*.dump
*.sql.bak

# --- ML artifacts too large or regenerable ---
ml/*.joblib
!ml/model.joblib

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Build and packaging output ---
*.zip
!docs/**/*.zip

# --- Test artifacts (regenerated by `npm run test:report`) ---
tests/results.json
coverage/
