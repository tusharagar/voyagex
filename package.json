{
  "name": "voyagex",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "VoyageX — test runner for the whole project (Phase 8). The dependencies below are the server's runtime packages, needed here because the tests import server modules and Vitest resolves from the repository root rather than from server/node_modules.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --reporter=json --outputFile=tests/results.json && node scripts/generate_test_table.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
